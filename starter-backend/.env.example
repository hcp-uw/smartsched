PORT=3001

# Supabase (backend routes that use Supabase)
# Create a project at https://supabase.com, then copy values from Project Settings -> API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# WARNING: server-only secret. Do NOT expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# For starter-backend/api/actions.js (Gemini), if you use that route.
# GEMINI_API_KEY=

# Frontend (Vite): copy starter-frontend/.env.example to starter-frontend/.env
# and set VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY to the same project.
